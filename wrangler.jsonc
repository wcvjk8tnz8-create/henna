{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "henna",
  "main": "worker.ts",
  "compatibility_date": "2025-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Henna must never cache authenticated responses or mail-related assets.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // No `vars` block, on purpose.
  //
  // Henna needs only DOMAIN, ADMIN and jwt_secret, and they are entered once in
  // the dashboard: Worker → Settings → Variables and Secrets → Add. Declaring
  // them here as well makes the deploy dialog show two groups of the same three
  // names — one plaintext, one encrypted — which is confusing and invites
  // editing the wrong one. One place, one source of truth.
  //
  // Add them as *Secrets* (encrypted), not plain text:
  //   DOMAIN       JSON value, e.g. ["example.com"]
  //   ADMIN        your email; this becomes the first administrator
  //   jwt_secret   random letters and digits, any length (openssl rand -hex 24)
  //
  // Nothing else is needed:
  //   HENNA_CREDENTIAL_KEY — derived from jwt_secret by HKDF when absent.
  //   GitHub OAuth, Resend/Brevo/Mailjet, object storage — /admin/settings.
  //   Registration mode and TOTP policy — /admin/settings, safe defaults.

  // Database. Declared by NAME, not by id: Cloudflare creates the D1 database on
  // first deploy, so there is no id to copy and nothing to paste here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "henna-db",
      "migrations_dir": "db/migrations/d1"
    }
  ],

  // Attachments AND raw inbound messages. Declared by name; the bucket is
  // created on first deploy.
  //
  // Henna is a mail service: `worker.ts` exports an `email()` handler alongside
  // `fetch()`. To receive mail, open Cloudflare Dashboard -> your domain ->
  // Email -> Email Routing -> Email Workers, and create a route (or a catch-all)
  // pointing at this Worker. See docs/cloudflare-deployment.md.
  // The browser reads and writes it through presigned URLs, so Henna never
  // proxies attachment bytes.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "henna-attachments"
    }
  ]

  // Bringing your own PostgreSQL instead of D1? Replace d1_databases above with:
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_CONFIG_ID>" }
  // ]
  // and set HENNA_DB_KIND=postgres. See docs/cloudflare-deployment.md.
}
