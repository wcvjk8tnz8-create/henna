# --- Root configuration (required, environment only) -------------------------
DOMAIN=["example.com","example2.com"]
ADMIN=root@example.com
jwt_secret=aRandomStringOfLettersAndDigitsAtLeast32Long
HENNA_CREDENTIAL_KEY=base64-of-32-random-bytes

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://henna:henna@localhost:5432/henna

# --- Optional: set these here or later in /admin/settings -------------------
AUTH_URL=http://localhost:3000
AUTH_SECRET=a-long-random-string-for-authjs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
HENNA_EMAIL_FROM=Henna <no-reply@example.com>
HENNA_REGISTRATION_MODE=closed
HENNA_TOTP_POLICY=admin-only

# --- Object storage (attachments) -------------------------------------------
# Optional when configured in /admin/settings instead. The CSP is emitted at
# build time, so the bucket origin must be known here too if you want browser
# uploads to be allowed without a redeploy after changing it in the UI.
HENNA_R2_ACCOUNT_ID=
HENNA_STORAGE_ORIGINS=https://<account>.r2.cloudflarestorage.com
